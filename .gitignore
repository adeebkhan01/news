# Nothing here is a dependency of the site — the page and the fetcher have no
# packages at all. This exists so a local `npm install playwright` for a
# browser check can't end up in a commit.
node_modules/
package-lock.json
package.json
# Root-only: a stray screenshot from local testing, not images/ — those PNGs
# are real site content the fetch workflow downloads and commits on purpose.
/*.png
